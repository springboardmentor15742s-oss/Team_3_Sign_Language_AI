# Application Config
PROJECT_NAME="AI Sign Language Learning & Assessment Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=signlang_user
POSTGRES_PASSWORD=signlang_secure_pass
POSTGRES_DB=signlang_db
DATABASE_URL=postgresql://signlang_user:signlang_secure_pass@localhost:5432/signlang_db

# CORS Settings (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# File Upload Settings
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB
UPLOAD_DIR=uploads/profile_pictures
