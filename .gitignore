venv/
node_modules/
__pycache__/
*.pyc
*.bak
.env
.DS_Store

# Local dev/test SQLite DB — accumulates throwaway test learners and other
# local state from running the app and test scripts; not real project state.
backend/sign_language_platform.db
backend/data/*
!backend/data/models/
backend/data/models/*
!backend/data/models/gesture_classifier.pkl
!backend/data/models/msasl_intermediate_classifier.pkl
!backend/data/curriculum/
!backend/data/curriculum/README.md
!backend/data/curriculum/msasl_curriculum_labels.json
# word-signs reference images are app-shipped assets (generated by
# scripts/extract_word_sign_reference_images.py from real MS-ASL training
# clips), not user uploads -- same "ship the real file" treatment as the
# model .pkl files above. Everything else under data/uploads/ (instructor-
# uploaded assignment media, learner-uploaded content) stays ignored.
!backend/data/uploads/
backend/data/uploads/*
!backend/data/uploads/word-signs/
# Generated manifests contain licensed source annotations; regenerate locally
# with backend/scripts/build_msasl_curriculum.py instead of committing them.
backend/data/curriculum/manifests/

# Root-level /data — the downloaded Kaggle ASL-signs subset (900 landmark
# parquet files + metadata) and any downloaded MS-ASL video clips. Both are
# large binary datasets regenerable via the scripts in backend/scripts/; the
# MS-ASL clips are additionally licensed under C-UDA 0.1 (computational/
# research use only — see backend/data/curriculum/README.md) and must not be
# redistributed via git.
/data/asl-signs/
/data/external/
